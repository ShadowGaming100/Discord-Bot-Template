# Secrets — keep this file out of git (see .gitignore). Copy to .env and fill.
# Bot — required
SETTINGS_BOT_TOKEN=your_bot_token_here
SETTINGS_BOT_CLIENTID=your_client_id_here
# Optional client secret
SETTINGS_BOT_CLIENTSECRET=

SERVER_POSTGRES_HOST=localhost
SERVER_POSTGRES_PORT=5432
SERVER_POSTGRES_USER=postgres
SERVER_POSTGRES_PASSWORD=
SERVER_POSTGRES_DATABASE=discord_bot
SERVER_POSTGRES_SSL=false
SERVER_POSTGRES_NOVERIFYSSL=false

LOGS_ERRORLOGS_WEBHOOK=
LOGS_COMMANDLOGS_WEBHOOK=
LOGS_CLIENTLOGS_WEBHOOK=

DB_DEBUG=false
